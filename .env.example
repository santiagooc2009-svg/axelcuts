# ---------------------------------------------------------------------------
# Supabase  (Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Salta las reglas de seguridad de la base: solo en el servidor,
# nunca en un archivo que llegue al navegador ni en un commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# Con esto se arman los links que van dentro de los WhatsApp.
# En Vercel: https://tu-proyecto.vercel.app (o tu dominio propio).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege /api/cron/dispatch. Invéntate una cadena larga al azar.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Notificaciones push (opcional; sin esto la app funciona, solo no notifica)
# Generar con: npm run gen:vapid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ---------------------------------------------------------------------------
# WhatsApp
#   wa_link   → el sistema escribe el mensaje y tu lo mandas de un toque.
#               Sin costo, sin tramites. Es el modo por omision.
#   cloud_api → envio automatico con la API de Meta. Requiere cuenta de
#               WhatsApp Business, numero verificado y plantillas aprobadas.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=wa_link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
